        }
      },
      "commit": "2e6d1fd289eda4230cb1d031e2ea71489357b868",
      "note": "The same source as the wasm, built for a host that imports it. Platform-specific: `abi3` frees it from the Python version, not from the machine, so it is keyed by platform: the build machine's, and win-amd64 and macosx-universal2, cross-built. macOS is keyed without a version and the one file carries arm64 and x86_64."
    },
    "board": {
      "model": "rknn",
      "file": "runtime/board/controller",
      "platform": "aarch64-unknown-linux-gnu",
      "commit": "2e6d1fd289eda4230cb1d031e2ea71489357b868",
      "note": "The robot's whole program: this crate, cross-compiled. From the bundle's directory: `./runtime/board/controller --bundle . --machine <toml>`."
